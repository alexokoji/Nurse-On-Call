# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NurseOnCall

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/nurseoncall
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/nurseoncall?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nurseoncall

# ─────────────────────────────────────────────
# Authentication
# Generate with: openssl rand -base64 32
# ─────────────────────────────────────────────
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_SESSION_MAX_AGE=604800

# ─────────────────────────────────────────────
# Payments — provider is selected at runtime.
# Supported: paystack | flutterwave | korapay
# ─────────────────────────────────────────────
PAYMENT_DEFAULT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=replace-me

KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# Email
#
# EMAIL_PROVIDER = console | resend | smtp
#
#   console  development default — prints to the server log, sends nothing.
#            Password reset does NOT work in this mode.
#   resend   HTTP API, nothing to install, good on serverless.
#   smtp     any mailbox you already own (Google Workspace, Zoho, cPanel…).
#
# EMAIL_FROM must be an address on a domain the provider has verified,
# or messages will be rejected or land in spam.
# ─────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="NurseOnCall <no-reply@nurseoncall.ng>"

# resend
RESEND_API_KEY=

# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─────────────────────────────────────────────
# SMS — SMS_PROVIDER = console | termii
# ─────────────────────────────────────────────
SMS_PROVIDER=console
SMS_SENDER_ID=NurseOnCall
TERMII_API_KEY=

# ─────────────────────────────────────────────
# Image storage (Cloudinary)
#
# Uploads are signed and performed server-side, so the API secret never
# reaches the browser. Without these, image fields fall back to pasting a URL.
# Find all three on the Cloudinary dashboard.
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Scheduled tasks
#
# /api/cron releases abandoned booking holds and sends appointment reminders.
# It refuses to run unless this is set. Generate with:
#   openssl rand -hex 32
#
# Vercel Cron sends it automatically as a bearer token (see vercel.json);
# other schedulers can send it as the x-cron-secret header.
# ─────────────────────────────────────────────
CRON_SECRET=

# How often the schedule actually fires, in hours. vercel.json runs daily
# because Vercel's Hobby plan allows no more; set 0.25 for every 15 minutes.
#
# Reminders widen their window by this much, so an appointment never falls
# between two runs. Too small a value here with too slow a schedule means
# some reminders are skipped.
CRON_INTERVAL_HOURS=24

# ─────────────────────────────────────────────
# Seeding (development only — never use in production)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@nurseoncall.ng
SEED_ADMIN_PASSWORD=Admin@12345
